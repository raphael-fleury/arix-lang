import monoid(Monoid)
import functor(Functor)
import applicative(Applicative)
import monad(Monad)
import bool(True, False)

enum Result(a, e) = Ok(value: a), Err(error: e)

public fn getOrElse(result, defaultValue) =
    match result:
        Ok(v) -> v
        Err(_) -> defaultValue

public fn isOk(result) =
    match result:
        Ok(_) -> True
        Err(_) -> False

impl Functor for Result
    map(x, f) =
        match x:
            Ok(v) -> Ok(f(v))
            Err(e) -> Err(e)

impl Applicative for Result
    pure(x, value) = Ok(value)
    apply(x, ff) =
        match ff:
            Ok(f) -> map(x, f)
            Err(e) -> Err(e)

impl Monad for Result
    flatMap(x, f) =
        match x:
            Ok(v) -> f(v)
            Err(e) -> Err(e)
