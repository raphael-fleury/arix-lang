"""
Bool - canonical boolean ADT.
"""

enum Bool = True, False

@Operator("&&", "infix", 3)
public fn and(x Bool, y Bool) =
  match x:
    True -> y
    False -> False

@Operator("||", "infix", 2)
public fn or(x Bool, y Bool) =
  match x:
    True -> True
    False -> y

@Operator("!", "prefix", 4)
public fn not(x Bool) =
  match x:
    True -> False
    False -> True