"""
List utilities for working with immutable lists.
"""

import maybe(Maybe, Some, None)
import monoid(Monoid)
import functor(Functor)
import applicative(Applicative)
import monad(Monad)

public fn head(xs) =
    match xs:
        [] -> None
        [h | _] -> Some(h)

public fn last(xs) =
    match xs:
        [] -> None
        [x] -> Some(x)
        [_ | t] -> last(t)

public fn length(xs) =
    match xs:
        [] -> 0
        [_ | t] -> 1 + length(t)

public fn isEmpty(xs) =
    match xs:
        [] -> true
        _ -> false

impl Monoid for List
    empty(x) = []
    combine(x, y) = x.concat(y)

impl Functor for List
    map(x, f) = x.map(f)

impl Applicative for List
    pure(x, value) = [value]
    apply(x, ff) = ff.flatMap((f) -> x.map((v) -> f(v)))

impl Monad for List
    pureM(x, value) = [value]
    flatMap(x, f) = x.flatMap(f)
