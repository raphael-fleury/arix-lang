"""
List utilities for working with immutable lists.
"""

import maybe(Maybe, Some, None)
import monoid(Monoid)
import functor(Functor)
import applicative(Applicative)
import monad(Monad)

type List(a) = Nil | Cons(head: a, tail: List(a))

fn append(xs, ys) =
    match xs:
        [] -> ys
        [h | t] -> [h | append(t, ys)]

public fn head(xs) =
    match xs:
        [] -> None
        [h | _] -> Some(h)

public fn last(xs) =
    match xs:
        [] -> None
        [x] -> Some(x)
        [_ | t] -> last(t)

public fn length(xs) =
    match xs:
        [] -> 0
        [_ | t] -> 1 + length(t)

public fn isEmpty(xs) =
    match xs:
        [] -> true
        _ -> false

impl Monoid for List
    empty(x) = []
    combine(x, y) = append(x, y)

impl Functor for List
    map(x, f) =
        match x:
            [] -> []
            [h | t] -> [f(h) | map(t, f)]

impl Applicative for List
    pure(x, value) = [value]
    apply(x, ff) =
        match ff:
            [] -> []
            [f | fs] -> append(map(x, f), apply(x, fs))

impl Monad for List
    pureM(x, value) = [value]
    flatMap(x, f) =
        match x:
            [] -> []
            [h | t] -> append(f(h), flatMap(t, f))
