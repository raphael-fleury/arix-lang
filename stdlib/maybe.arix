"""
Maybe - optional value type.
"""

import monoid(Monoid)
import functor(Functor)
import applicative(Applicative)
import monad(Monad)
import bool(True, False)

enum Maybe(a) = Some(value: a), None

public fn getOrElse(value, defaultValue) =
    match value:
        Some(v) -> v
        None -> defaultValue

public fn isSome(value) =
    match value:
        Some(_) -> True
        None -> False

impl Monoid for Maybe
    empty(x) = None
    combine(x, y) =
        match x:
            Some(_) -> x
            None -> y

impl Functor for Maybe
    map(x, f) =
        match x:
            Some(v) -> Some(f(v))
            None -> None

impl Applicative for Maybe
    pure(x, value) = Some(value)
    apply(x, ff) =
        match ff:
            Some(f) -> map(x, f)
            None -> None

impl Monad for Maybe
    flatMap(x, f) =
        match x:
            Some(v) -> f(v)
            None -> None
