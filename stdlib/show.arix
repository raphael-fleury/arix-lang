"""
Show typeclass and core instances for stdlib types.
"""

typeclass Show(a)
  show(x a) -> String

impl Show for Int
  show(x) = x.toString()

impl Show for Float
  show(x) = x.toString()

impl Show for Bool
  show(x) =
    match x:
      True -> "True"
      False -> "False"

impl Show for String
  show(x) = x

fn showAdtValues(values) =
  values.map((v) -> show(v)).join(", ")

impl Show for ADT
  show(x) =
    if x._values.length == 0:
      x._variant
    else:
      x._variant ++ "(" ++ showAdtValues(x._values) ++ ")"
