"""
Show typeclass and core instances for stdlib types.
"""

typeclass Show(a)
  show(x a) -> String

impl Show for Int
  show(x) = js.String(runtime.UNBOX(x))

impl Show for Float
  show(x) = js.String(runtime.UNBOX(x))

impl Show for String
  show(x) = x

impl Show for Char
  show(x) = x

fn showAdtValues(values) =
  values.map((v) -> show(v)).join(", ")

impl Show for ADT
  show(x) =
    match x._values.length:
      0 -> x._variant
      _ -> x._variant ++ "(" ++ showAdtValues(x._values) ++ ")"
