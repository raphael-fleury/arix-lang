typeclass Num(a)
  @Operator("+", "infix", 4)
  add(x a, y a) -> a
  @Operator("-", "infix", 4)
  subtract(x a, y a) -> a
  @Operator("*", "infix", 4)
  multiply(x a, y a) -> a
  @Operator("/", "infix", 4)
  divide(x a, y a) -> a
  @Operator("-", "prefix", 4)
  negate(x a) -> a
  abs(x a) -> a
  signum(x a) -> a

impl Num for Int
  add(x, y) = js.ADD(x, y)
  subtract(x, y) = js.SUB(x, y)
  multiply(x, y) = js.MUL(x, y)
  divide(x, y) = js.DIV_INT(x, y)
  negate(x) = js.NEG(x)
  abs(x) = match x < 0:
    True -> js.NEG(x)
    False -> x
  signum(x) = match x < 0:
    True -> -1
    False -> match x > 0:
      True -> 1
      False -> 0

impl Num for Float
  add(x, y) = js.ADD(x, y)
  subtract(x, y) = js.SUB(x, y)
  multiply(x, y) = js.MUL(x, y)
  divide(x, y) = js.DIV(x, y)
  negate(x) = js.NEG(x)
  abs(x) = match x < 0.0:
    True -> js.NEG(x)
    False -> x
  signum(x) = match x < 0.0:
    True -> -1.0
    False -> match x > 0.0:
      True -> 1.0
      False -> 0.0