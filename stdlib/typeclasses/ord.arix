import bool(True, False)

typeclass Ord(a)
  @Operator("<", "infix", 4)
  lt(x a, y a) -> Bool
  @Operator(">", "infix", 4)
  gt(x a, y a) -> Bool
  @Operator("<=", "infix", 4)
  lte(x a, y a) -> Bool = !(gt(x, y))
  @Operator(">=", "infix", 4)
  gte(x a, y a) -> Bool = !(lt(x, y))

impl Ord for Int
  lt(x, y) = match js.LT(x, y).toString():
    "true" -> True
    _ -> False
  gt(x, y) = match js.GT(x, y).toString():
    "true" -> True
    _ -> False
  lte(x, y) = match js.LTE(x, y).toString():
    "true" -> True
    _ -> False
  gte(x, y) = match js.GTE(x, y).toString():
    "true" -> True
    _ -> False

impl Ord for Float
  lt(x, y) = match js.LT(x, y).toString():
    "true" -> True
    _ -> False
  gt(x, y) = match js.GT(x, y).toString():
    "true" -> True
    _ -> False
  lte(x, y) = match js.LTE(x, y).toString():
    "true" -> True
    _ -> False
  gte(x, y) = match js.GTE(x, y).toString():
    "true" -> True
    _ -> False

impl Ord for String
  lt(x, y) = match js.LT(x, y).toString():
    "true" -> True
    _ -> False
  gt(x, y) = match js.GT(x, y).toString():
    "true" -> True
    _ -> False
  lte(x, y) = match js.LTE(x, y).toString():
    "true" -> True
    _ -> False
  gte(x, y) = match js.GTE(x, y).toString():
    "true" -> True
    _ -> False