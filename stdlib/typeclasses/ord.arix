import bool(True, False)

typeclass Ord(a)
  @Operator("<", "infix", 4)
  lt(x a, y a) -> Bool
  @Operator(">", "infix", 4)
  gt(x a, y a) -> Bool
  @Operator("<=", "infix", 4)
  lte(x a, y a) -> Bool = !(gt(x, y))
  @Operator(">=", "infix", 4)
  gte(x a, y a) -> Bool = !(lt(x, y))

impl Ord for Int
  lt(x, y) = runtime.BOOL(runtime.LT(x, y))
  gt(x, y) = runtime.BOOL(runtime.GT(x, y))
  lte(x, y) = runtime.BOOL(runtime.LTE(x, y))
  gte(x, y) = runtime.BOOL(runtime.GTE(x, y))

impl Ord for Float
  lt(x, y) = runtime.BOOL(runtime.LT(x, y))
  gt(x, y) = runtime.BOOL(runtime.GT(x, y))
  lte(x, y) = runtime.BOOL(runtime.LTE(x, y))
  gte(x, y) = runtime.BOOL(runtime.GTE(x, y))

impl Ord for String
  lt(x, y) = runtime.BOOL(runtime.LT(x, y))
  gt(x, y) = runtime.BOOL(runtime.GT(x, y))
  lte(x, y) = runtime.BOOL(runtime.LTE(x, y))
  gte(x, y) = runtime.BOOL(runtime.GTE(x, y))