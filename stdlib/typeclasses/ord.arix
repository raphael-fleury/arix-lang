import bool(True, False)

typeclass Ord(a)
  @Operator("<", "infix", 4)
  lt(x a, y a) -> Bool
  @Operator(">", "infix", 4)
  gt(x a, y a) -> Bool
  @Operator("<=", "infix", 4)
  lte(x a, y a) -> Bool = !(gt(x, y))
  @Operator(">=", "infix", 4)
  gte(x a, y a) -> Bool = !(lt(x, y))

impl Ord for Int
  lt(x, y) = if js.LT(x, y) then True else False
  gt(x, y) = if js.GT(x, y) then True else False
  lte(x, y) = if js.LTE(x, y) then True else False
  gte(x, y) = if js.GTE(x, y) then True else False

impl Ord for Float
  lt(x, y) = if js.LT(x, y) then True else False
  gt(x, y) = if js.GT(x, y) then True else False
  lte(x, y) = if js.LTE(x, y) then True else False
  gte(x, y) = if js.GTE(x, y) then True else False

impl Ord for String
  lt(x, y) = if js.LT(x, y) then True else False
  gt(x, y) = if js.GT(x, y) then True else False
  lte(x, y) = if js.LTE(x, y) then True else False
  gte(x, y) = if js.GTE(x, y) then True else False