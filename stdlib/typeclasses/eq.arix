"""
Eq typeclass and core instances for primitive types.
"""

import bool(True, False)

typeclass Eq(a)
  @Operator("==", "infix", 4)
  eq(x a, y a) -> Bool
  @Operator("!=", "infix", 4)
  notEq(x a, y a) -> Bool = !(eq(x, y))

impl Eq for Int
  eq(x, y) = js.EQ(x, y)

impl Eq for Float
  eq(x, y) = js.EQ(x, y)

impl Eq for String
  eq(x, y) = js.EQ(x, y)

impl Eq for Bool
  eq(x, y) =
    match x:
      True -> y
      False -> notEq(y)
